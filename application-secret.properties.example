# ===========================================
# 敏感配置模板（可安全提交，不含任何真实密钥）
# ===========================================
# 使用方式：
#   1. 复制本文件为 application-secret.properties（与主配置同目录）
#      Windows:  copy application-secret.properties.example application-secret.properties
#      macOS/Linux:  cp application-secret.properties.example application-secret.properties
#   2. 把下面的占位值替换成你自己的真实 Key
#
# 为什么单独放一个文件：
#   application-secret.properties 已被 .gitignore 排除（不会提交到 Git），
#   本模板只含占位符，用于告知协作者需要配置哪些项。
#
# 生效方式：
#   主配置 application.properties 中 spring.profiles.active=secret 会自动加载它。
# ===========================================

# ---------- 1. 大模型对话【必填】 ----------
# DeepSeek 开放平台：https://platform.deepseek.com/ -> API Keys
# 缺失后果：主对话功能完全不可用
spring.ai.deepseek.api-key=sk-请替换为你的DeepSeekKey

# ---------- 2. 向量化 / RAG 知识库【必填】 ----------
# 阿里云百炼（通义 text-embedding-v3）：https://bailian.console.aliyun.com/ -> API-KEY
# 注意：地域需与 application.properties 中 dashscope.base-url 一致（默认华北2-北京）
# 缺失后果：EmbeddingModelConfig 启动失败（该 key 无默认值）
dashscope.api-key=sk-请替换为你的阿里云百炼Key

# ---------- 3. 图片识别【可选】 ----------
# 智谱 GLM-4V-Flash：https://open.bigmodel.cn/ -> API Keys -> 创建
# 缺失后果：图片分析（聊天截图识别）不可用
glm4v.api-key=请替换为你的智谱Key

# ---------- 4. 图片搜索【可选】 ----------
# Pexels：https://www.pexels.com/api/ -> 申请免费 Key
# 缺失后果：AI 的图片搜索工具不可用
pexels.api-key=请替换为你的PexelsKey

# ---------- 5. 天气 / POI 搜索【可选】 ----------
# 高德开放平台：https://lbs.amap.com/ -> 控制台 -> 应用管理 -> 创建应用
#   -> 添加 Key，服务平台选「Web服务」
# 缺失后果：天气查询、附近地点推荐不可用
amap.api-key=请替换为你的高德Web服务Key

# ---------- 6. 数据库【必填】 ----------
# 本机（或远程）MySQL 的密码，需与 application.properties 中
# spring.datasource.username 对应
# 若使用无密码的本地库，保留空值即可：spring.datasource.password=
spring.datasource.password=请替换为你的MySQL密码

# ---------- 7. 微信推送【可选】 ----------
# Server酱：https://sct.ftqq.com/ -> 微信扫码登录 -> 复制 SendKey
# 缺失后果：每日单词推送功能不可用
wechat.push.server-chan-key=请替换为你的Server酱SendKey
